---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileSidebar from '../components/MobileSidebar.astro';

const links = [
  { href: '/', label: 'Beranda', i18n: 'legal.home', icon: 'home' },
  { href: '/#features', label: 'Fitur', i18n: 'nav.features', icon: 'car' },
  { href: '/#faq', label: 'FAQ', i18n: 'nav.faq', icon: 'help' },
  { href: '/changelog', label: 'Changelog', icon: 'clipboard' },
];
---
<BaseLayout title="Kebijakan Privasi — SteerIn" description="Bagaimana SteerIn menyimpan dan memproses data kendaraan, akun, lokasi, dan backup." canonical="https://steerin.app/privacy-policy/" bodyClass="policy-page">
  <div class="container">
    <Navbar links={links} ctaHref="/#download" showLanguage={true} />
    <header class="policy-hero">
      <a href="/" class="changelog-back" data-i18n="legal.back">← Kembali ke Beranda</a>
      <h1 data-i18n="policy.title">Kebijakan Privasi</h1>
      <p data-i18n="policy.intro">SteerIn membantu mengelola kendaraan. Berikut cara data kamu digunakan dan disimpan.</p>
      <div class="policy-meta"><span data-i18n="policy.updated">Terakhir diperbarui: 6 Oktober 2026</span><span data-i18n="policy.beta">Berlaku untuk versi beta</span></div>
    </header>
    <main class="policy-content" id="main" tabindex="-1">
      <section class="policy-section" id="data-collected"><h2 data-i18n="policy.data.title">Data yang dikumpulkan</h2><p data-i18n="policy.data.body">Kamu memasukkan profil kendaraan, catatan servis, biaya, dan perjalanan. Lokasi dipakai saat trip tracking aktif; kamera dipakai saat fitur scan atau foto kendaraan dipilih. Login memproses identitas akun melalui layanan yang digunakan aplikasi.</p></section>
      <section class="policy-section" id="data-usage"><h2 data-i18n="policy.usage.title">Penggunaan data</h2><p data-i18n="policy.usage.body">Data digunakan untuk menampilkan kesehatan kendaraan, pengingat, riwayat, dan laporan. Log kesalahan lokal dan diagnostik crash jarak jauh opsional dapat dipakai jika dikonfigurasi.</p></section>
      <section class="policy-section" id="location"><h2 data-i18n="policy.location.title">Lokasi dan kamera</h2><p data-i18n="policy.location.body">Lokasi foreground digunakan untuk perjalanan aktif. Izin lokasi background dapat diminta setelah kamu memulai trip dan memilih pelacakan saat aplikasi tidak terlihat. Kamu bisa menghentikan trip kapan saja. Kamera hanya digunakan untuk scan odometer dan foto opsional.</p></section>
      <section class="policy-section" id="notifications"><h2 data-i18n="policy.notifications.title">Notifikasi dan laporan</h2><p data-i18n="policy.notifications.body">Notifikasi dapat digunakan untuk pengingat servis, pembaruan sistem, dan trip aktif. Laporan mingguan bersifat opsional; pengiriman email dapat menggunakan penyedia email transaksional tanpa koordinat rute GPS mentah.</p></section>
      <section class="policy-section" id="storage"><h2 data-i18n="policy.storage.title">Penyimpanan dan backup</h2><p data-i18n="policy.storage.body">Data inti disimpan lokal melalui Room dan DataStore. Backup file dipilih pengguna. Jika backup cloud diaktifkan, pengenal akun dan data backup disimpan melalui Supabase; preferensi laporan dapat disinkronkan jika fitur pengiriman diaktifkan.</p></section>
      <section class="policy-section" id="sharing"><h2 data-i18n="policy.sharing.title">Layanan pihak ketiga</h2><p data-i18n="policy.sharing.body">SteerIn tidak bermaksud menjual data pribadi. Fitur tertentu dapat memakai Supabase, layanan lokasi/peta Google, Logo.dev, dan penyedia diagnostik crash opsional. Ketersediaannya bergantung pada konfigurasi aplikasi.</p></section>
      <section class="policy-section" id="control"><h2 data-i18n="policy.control.title">Kontrol pengguna</h2><p data-i18n="policy.control.body">Kamu dapat mengedit atau menghapus data kendaraan, mengekspor dan memulihkan backup lokal, menghapus backup cloud, keluar dari cloud sync, dan menonaktifkan laporan mingguan. Untuk penghapusan akun cloud, hubungi pengelola aplikasi sampai fitur mandiri tersedia.</p></section>
      <section class="policy-section" id="contact"><h2 data-i18n="policy.contact.title">Kontak</h2><p><span data-i18n="policy.contact.body">Pertanyaan tentang data pribadi:</span> <a href="mailto:sudutkamar.co@gmail.com">sudutkamar.co@gmail.com</a></p></section>
    </main>
    <Footer homePrefix="/" i18n={true} />
  </div>
  <MobileSidebar links={links} ctaHref="/#download" ctaLabel="Download" showLanguage={true} description="Kebijakan Privasi SteerIn" descriptionI18n="policy.title" />
</BaseLayout>
